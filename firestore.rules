rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated users with valid role claim ('nabin' or 'karu') minted via correct PIN
    function isAuthenticated() {
      return request.auth != null
        && (request.auth.token.role in ['nabin', 'karu'] || request.auth.uid in ['nabin', 'karu']);
    }

    function isUser(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.token.role == userId
      );
    }

    function isCallParticipant(callData) {
      return isAuthenticated() && (
        request.auth.uid == callData.callerId ||
        request.auth.uid == callData.calleeId ||
        request.auth.token.role == callData.callerId ||
        request.auth.token.role == callData.calleeId
      );
    }

    // Messages: Authorized couple can read.
    // Create: must be authentic sender UID or role.
    // Update: Sender can update own message. Partner can only update delivery status or reactions.
    // Delete: Sender only.
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.senderUid == request.auth.uid ||
        request.resource.data.senderRole == request.auth.uid ||
        request.resource.data.senderRole == request.auth.token.role
      );
      allow update: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.senderRole == request.auth.uid ||
        resource.data.senderRole == request.auth.token.role ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'seenAt', 'deliveredAt', 'reactions', 'reactionsSummary'])
      );
      allow delete: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.senderRole == request.auth.uid ||
        resource.data.senderRole == request.auth.token.role
      );
    }

    // Calls: Only caller and callee can participate.
    match /calls/{callId} {
      allow read: if isAuthenticated() && (
        resource == null || isCallParticipant(resource.data)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.callerId == request.auth.uid ||
        request.resource.data.callerId == request.auth.token.role
      );
      allow update: if isAuthenticated() && isCallParticipant(resource.data);
      allow delete: if isAuthenticated() && isCallParticipant(resource.data);

      match /callerCandidates/{candId} {
        allow read, write: if isAuthenticated();
      }

      match /calleeCandidates/{candId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Users & FCM tokens: User can only update their own record
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId);
    }

    // Profiles: User can only write their own profile doc
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId);
    }

    // Presence: User can only write their own presence
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId);
    }

    // Typing indicators: User can only update their own typing state
    match /typing/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId);
    }

    // Read receipts: User can only update their own read receipt timestamp
    match /readReceipts/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId);
    }

    // Reactions: Authenticated users can add or remove their own reactions
    match /reactions/{reactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.token.role
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.token.role
      );
      allow update: if false;
    }

    // Shared Couple Collections
    match /memories/{memoryId} {
      allow read, write: if isAuthenticated();
    }

    match /stats/{statId} {
      allow read, write: if isAuthenticated();
    }

    match /global_stats/{statId} {
      allow read, write: if isAuthenticated();
    }

    match /sparks/{sparkId} {
      allow read, write: if isAuthenticated();
    }

    match /keyDates/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /nudges/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /bucketList/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Moods: User can only write their own mood
    match /moods/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.token.role
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.token.role
      );
    }

    // Time Capsules: Sealed love messages.
    // Recipient cannot read until unlock time has arrived.
    match /timeCapsules/{docId} {
      allow create: if isAuthenticated() && (
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.senderId == request.auth.token.role
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.senderId == request.auth.token.role
      );
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.senderId == request.auth.uid ||
        resource.data.senderId == request.auth.token.role ||
        (resource.data.unlockDate != null && string(request.time) >= resource.data.unlockDate)
      );
    }
  }
}
