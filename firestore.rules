rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated users with valid role claim ('nabin' or 'karu') minted via correct PIN
    function isAuthenticated() {
      return request.auth != null
        && request.auth.token.role in ['nabin', 'karu'];
    }

    // Messages: anyone authenticated with role can read.
    // Create: must be your own uid.
    // Update: only allow changing status/reactions-adjacent fields on others' messages.
    //         Sender can update all their own fields.
    // Delete: only sender.
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.senderUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        // Sender can update anything on their own message
        resource.data.senderUid == request.auth.uid
        ||
        // Partner can only touch status field (delivered/seen)
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']))
      );
      allow delete: if isAuthenticated()
        && resource.data.senderUid == request.auth.uid;
    }

    // Calls & WebRTC Signaling: authenticated users with role can read/write calls & candidates
    match /calls/{callId} {
      allow read, write: if isAuthenticated();
      match /{subcollection=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Users & FCM tokens: authenticated users with role can read/write user documents
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Profiles: anyone authenticated with role can read. Only write your own profile doc.
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && (
          !exists(/databases/$(database)/documents/profiles/$(userId))
          || resource.data.keys().hasAny(['lastActive'])  // allow self-update
        );
    }

    // Presence: only write your own presence doc (doc ID = your role).
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Typing: any authenticated user with role can write (needed for typing indicator).
    match /typing/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Reactions: authenticated users with role can add/remove their own reactions.
    match /reactions/{reactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow update: if false; // reactions are created/deleted, never updated
    }

    // Memories: both can read/write (shared space).
    match /memories/{memoryId} {
      allow read, write: if isAuthenticated();
    }

    // Stats: authenticated users with role can read; write is controlled (streak logic).
    match /stats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Sparks: authenticated users with role can read/write (AI love sparks).
    match /sparks/{sparkId} {
      allow read, write: if isAuthenticated();
    }

    // Key dates: shared, both can manage.
    match /keyDates/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Nudges (Thinking of You): authenticated users with role can read/write.
    match /nudges/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Moods: authenticated users with role can read all; write only your own.
    match /moods/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId is string;
      allow update, delete: if isAuthenticated()
        && resource.data.userId is string;
    }

    // Global Stats (relationship statistics)
    match /global_stats/{statId} {
      allow read, write: if isAuthenticated();
    }

    // Read Receipts
    match /readReceipts/{userId} {
      allow read, write: if isAuthenticated();
    }
  }
}
